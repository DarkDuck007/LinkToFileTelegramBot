# Telegram API credentials
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_PHONE=
TELETHON_PASSWORD=

# Telegram bot credentials
TELETHON_BOT_TOKEN=
TELETHON_BOT_USERNAME=
BOT_API_URL=https://api.telegram.org
TELETHON_BOT_SESSION=dev_bot
TELETHON_SESSION=dev_userbot

# Bale bot credentials
BALE_BOT_TOKEN=
BALE_API_URL=https://tapi.bale.ai
BALE_UPLOAD_TIMEOUT_SECONDS=1800

# Local runtime paths
DOWNLOAD_DIR=dev_downloads
HASH_DB_PATH=dev_hash_cache.db
MODERATION_DB_PATH=dev_moderation.db

# Admin access
ADMIN_TELEGRAM_IDS=
ADMIN_BALE_IDS=
ADMIN_REST_TOKEN=
ADMIN_REST_HOST=127.0.0.1
ADMIN_REST_PORT=8080

# Abuse-control and housekeeping settings
MAX_KEYS_PER_USER=10
DOWNLOAD_DIR_MAX_BYTES=4294967296
DOWNLOAD_CLEANUP_INTERVAL_SECONDS=900

# Broadcast throttling
TELEGRAM_BROADCAST_DELAY_SECONDS=1.0
BALE_BROADCAST_DELAY_SECONDS=1.0
BROADCAST_RETRY_COUNT=3
